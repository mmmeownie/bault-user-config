#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Homerow Mods";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <180>;
            require-prior-idle-ms = <0>;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        Caps-Lock {
            bindings = <&caps_word>;
            key-positions = <21 30>;
        };
    };

    macros {
        new_macro: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "NEW_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base-layer-0 {
            bindings = <
&kp Q               &kp W         &kp E     &kp R        &kp T  &kp Y        &kp U  &kp I         &kp O       &kp P                  &kp BACKSPACE
&hm LEFT_CONTROL A  &kp S         &kp D     &kp F        &kp G  &kp H        &kp J  &kp K         &kp L       &hm RCTRL ENTER
&hm LEFT_SHIFT Z    &kp X         &kp C     &kp V        &kp B  &kp N        &kp M  &kp COMMA     &kp PERIOD  &hm RIGHT_SHIFT SLASH
&none               &kp LEFT_ALT  &kp LGUI  &lt 2 SPACE         &lt 1 SPACE         &lt 3 DELETE  &kp RALT    &none
            >;
        };

        more-keys-1 {
            bindings = <
&kp N1   &kp N2     &kp N3  &kp N4    &kp N5    &kp MINUS  &kp N6   &kp N7         &kp N8                &kp N9  &kp N0
&kp TAB  &none      &none   &kp LBKT  &kp RBKT  &kp EQUAL  &kp SQT  &kp SEMICOLON  &kp NON_US_BACKSLASH  &trans
&trans   &none      &none   &none     &none     &none      &none    &none          &none                 &trans
&none    &kp GRAVE  &trans  &trans              &trans              &trans         &trans                &none
            >;
        };

        numpad-nav-2 {
            bindings = <
&kp ESCAPE  &none      &none      &none      &none  &kp N7  &kp N8  &kp N9      &kp SLASH  &none   &trans
&kp LEFT    &kp DOWN   &kp UP     &kp RIGHT  &none  &kp N4  &kp N5  &kp N6      &kp MINUS  &trans
&trans      &kp PG_DN  &kp PG_UP  &kp END    &none  &kp N1  &kp N2  &kp N3      &kp PLUS   &trans
&none       &kp INS    &none      &none             &kp N0          &kp PERIOD  &kp ASTRK  &none
            >;
        };

        funtion-keys-3 {
            bindings = <
&kp F1  &kp F2  &kp F3       &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans  &kp F12
&trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &bootloader  &trans          &trans          &trans  &trans  &trans
            >;
        };
    };
};
